{
  "name": "@flashbacktech/flashbackclient",
  "version": "0.4.0",
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "description": "",
  "scripts": {
    "dev": "tsc",
    "dev:watch": "nodemon --exec 'npm run dev || exit 1'",
    "lint": "eslint . --ext .ts",
    "build": "npm run dev",
    "test": "jest",
    "test:offline": "npm run build && jest --runInBand tests/oauthRegistration.test.ts tests/dependencyCompatibility.test.ts && node --test tests/gcsCompatibility.test.cjs tests/stellarCompatibility.test.cjs",
    "prepublishOnly": "npm run test:offline",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist",
    "format": "eslint \"**/*.ts\" --ignore-pattern 'dist/**' --fix && prettier --write . --ignore-path .gitignore",
    "docs": "typedoc",
    "pub": "npm publish --access public"
  },
  "author": "Javier Ortiz <javier.ortiz@flashback.tech>",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1163.0",
    "@google-cloud/storage": "^8.4.0",
    "@stellar/stellar-sdk": "^16.4.1",
    "axios": "^1.21.0",
    "formdata-node": "^6.0.3",
    "google-auth-library": "^11.3.3",
    "openai": "^6.49.0"
  },
  "exports": {
    "./stellarv2": {
      "types": "./dist/stellarv2/index.d.ts",
      "require": "./dist/stellarv2/index.js",
      "default": "./dist/stellarv2/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "require": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./gcs": {
      "types": "./dist/gcs/index.d.ts",
      "require": "./dist/gcs/index.js",
      "default": "./dist/gcs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@azure/storage-blob": "^12.34.0",
    "@eslint/js": "^8.56.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "typesVersions": {
    "*": {
      "stellarv2": [
        "./dist/stellarv2/index.d.ts"
      ],
      "api": [
        "./dist/api/index.d.ts"
      ],
      "gcs": [
        "./dist/gcs/index.d.ts"
      ]
    }
  }
}
